// Models are added by their owning module (e.g. User in the users module).
// The connection URL lives in prisma.config.ts (Prisma 7).

generator client {
  provider            = "prisma-client"
  output              = "../src/shared/database/generated"
  moduleFormat        = "cjs"
  // Extensionless imports resolve in both tsc (CJS) and Jest without a moduleNameMapper.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  // Stored normalized (trimmed, lowercased) by the Email value object.
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("users")
}
