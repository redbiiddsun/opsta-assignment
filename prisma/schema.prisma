// Models are added by their owning module (e.g. User in the users module).
// The connection URL lives in prisma.config.ts (Prisma 7).

generator client {
  provider            = "prisma-client"
  output              = "../src/shared/database/generated"
  moduleFormat        = "cjs"
  // Extensionless imports resolve in both tsc (CJS) and Jest without a moduleNameMapper.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// Owned by the users module.
model User {
  id        String   @id @default(uuid()) @db.Uuid
  // Stored normalized (trimmed, lowercased) by the Email value object.
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  credential    Credential?
  refreshTokens RefreshToken[]

  @@map("users")
}

// Owned by the auth module. One password per user; the user id is the key.
model Credential {
  userId       String @id @map("user_id") @db.Uuid
  passwordHash String @map("password_hash")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

// Owned by the auth module. One row per issued refresh token. Rotation
// revokes the row and inserts its successor; a revoked row is rejected.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  // SHA-256 of the opaque token; the token itself is never stored.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}
