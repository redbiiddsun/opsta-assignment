# Placeholder values only. Copy to .env and replace secrets.

PORT=3000

# Used by docker-compose to create the database
POSTGRES_USER=url_shortener
POSTGRES_PASSWORD=change-me
POSTGRES_DB=url_shortener
POSTGRES_PORT=5432

DATABASE_URL=postgresql://url_shortener:change-me@localhost:5432/url_shortener?schema=public

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
JWT_ISSUER=url-shortener-api
JWT_AUDIENCE=url-shortener-clients

# Lifetime of an opaque refresh token, in whole days
REFRESH_TOKEN_TTL_DAYS=7

# Base URL used to build short links (https://sho.rt/abc123)
PUBLIC_BASE_URL=http://localhost:3000
